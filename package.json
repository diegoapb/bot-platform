{
  "name": "bot-plataform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de bots sobre Evolution API (WhatsApp) + Chatwoot. Monorepo: backend Hono + frontend React.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "dev:backend": "pnpm --filter @bot/backend dev",
    "dev:frontend": "pnpm --filter @bot/frontend dev",
    "tunnel": "cloudflared tunnel --config ~/.cloudflared/config.yml run bot-plataform-dev",
    "dev:mobile": "pnpm --parallel --filter \"./apps/*\" dev & cloudflared tunnel --config ~/.cloudflared/config.yml run bot-plataform-dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @bot/backend db:generate",
    "db:migrate": "pnpm --filter @bot/backend db:migrate"
  }
}
