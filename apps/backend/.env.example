# ===========================================================================
# bot-plataform / backend (Hono) — plantilla de variables.
# En Dokploy el .env real vive en el Environment del compose y NO se versiona.
# ===========================================================================

NODE_ENV=production
# Ambiente lógico: prefija las instancias Evolution (dev-/qa-/prod-bot-<id>) para
# diferenciarlas en el Evolution/Chatwoot COMPARTIDO. Valores: dev | qa | prod.
DEPLOY_ENV=dev
PORT=3000
# Orígenes permitidos por CORS (coma-separados). En dev: http://localhost:5173
CORS_ORIGIN=https://sira.opensolvex.co

# ---- Postgres compartido (proyecto "databases" / postgres "labs-vector") ----
# Instancia pgvector/pgvector:pg15 (la única con la extensión vector).
# Hostname interno en dokploy-network: labs-vector-uvatca   Puerto: 5432
# Requiere DB + user "botplatform" creados y CREATE EXTENSION vector.
# El schema usa vector(1536)+HNSW, así que DEBE ser esta instancia.
DATABASE_URL=postgresql://botplatform:CHANGE_ME@labs-vector-uvatca:5432/botplatform

# ---- Redis compartido (proyecto "databases" / redis "Redis") ----
# Hostname interno: databases-redis-vlzs7g  Puerto: 6379  DB index: 5 (reservado a bot-plataform)
REDIS_URL=redis://default:CHANGE_ME@databases-redis-vlzs7g:6379/5

# ---- Clerk (auth managed) ----
# Dashboard Clerk -> API Keys. Requiere Organizations habilitado.
CLERK_SECRET_KEY=sk_test_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
# Bootstrap del primer super admin de plataforma: Clerk user ids separados por
# coma (p.ej. user_abc,user_def). Después se pueden gestionar con
# publicMetadata.role="superadmin" en Clerk. Vacío = ninguno por env.
SUPERADMIN_USER_IDS=

# ---- Evolution API (WhatsApp gateway en Dokploy) ----
# Público: https://evolutionapi.diegop.com  (header "apikey")
EVOLUTION_API_URL=https://evolutionapi.diegop.com
EVOLUTION_API_KEY=CHANGE_ME

# ---- Chatwoot (en Dokploy) ----
# Público: https://chatwoot.diegop.com
# Token: Chatwoot -> Profile Settings -> Access Token  (header "api_access_token")
CHATWOOT_API_URL=https://chatwoot.diegop.com
CHATWOOT_API_TOKEN=CHANGE_ME
CHATWOOT_ACCOUNT_ID=1
# User id del dueño de CHATWOOT_API_TOKEN. Se adjunta como administrator a cada
# cuenta de tenant para que el Application API pueda crear inboxes en ella.
# Obtenerlo: super_admin -> Users, o GET /platform/api/v1/users/{id}.
CHATWOOT_ADMIN_USER_ID=CHANGE_ME

# ---- Verificación de webhooks entrantes ----
# Secreto propio que comparas en el header de los webhooks que registres
# en Evolution/Chatwoot apuntando a este backend.
WEBHOOK_SECRET=CHANGE_ME

# Token que Evolution incluye en sus webhooks (configurado al crear instancia).
EVOLUTION_WEBHOOK_TOKEN=CHANGE_ME
# Base pública de este backend, alcanzable desde Evolution/Chatwoot (túnel en dev).
PUBLIC_WEBHOOK_BASE_URL=https://api.sira.opensolvex.co

# Token del Platform API de Chatwoot (superadmin -> Platform Apps).
CHATWOOT_PLATFORM_TOKEN=CHANGE_ME

# ---- IA: motor conversacional y base de conocimiento (E05/E06/E07) ----
# Embeddings de conocimiento (OpenAI). Sin esta key, las fuentes quedan en
# `failed` y el bot responde solo con identidad + catálogo.
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# LLM del motor (Anthropic). Sin esta key, el bot no responde y las
# conversaciones pasan a modo humano.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=12000
