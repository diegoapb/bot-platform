# ===========================================================================
# bot-plataform — variables del entorno de DESARROLLO local (docker-compose.dev.yml).
#
#   cp .env.dev.example .env.dev      (o simplemente `make env`)
#
# Los valores por defecto YA permiten arrancar el stack y probar la API contra
# la base de datos local con la data de prueba (`make up`). Para usar el LOGIN
# real (Clerk) y el motor de IA, rellena las claves marcadas como CHANGE_ME.
#
# Nota: DATABASE_URL y REDIS_URL las fija el propio compose apuntando a los
# servicios `db` y `redis`; lo que pongas aquí para esas dos se ignora.
# ===========================================================================

# ---- Puertos publicados en el host (cámbialos si chocan con algo local) ----
# DB_PORT por defecto 5433 para NO chocar con el túnel a Dokploy (dev-tunnel.sh, 5432).
DB_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=3000
FRONTEND_PORT=5173

# ---- Postgres local (lo consume el contenedor `db`) ----
POSTGRES_USER=botplatform
POSTGRES_PASSWORD=botplatform
POSTGRES_DB=botplatform

# ---- Backend ----
NODE_ENV=development
DEPLOY_ENV=dev
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---- Clerk (auth) ----
# Con los placeholders el backend ARRANCA, pero el login no funcionará: para
# entrar por la UI pon aquí el SECRET + PUBLISHABLE de una instancia de
# desarrollo de Clerk (https://dashboard.clerk.com -> API Keys) con
# Organizations habilitado. La clave PÚBLICA del frontend (VITE_CLERK_*) vive
# en apps/frontend/.env y debe ser de la MISMA instancia que el sk de aquí.
CLERK_SECRET_KEY=sk_test_dummy
CLERK_PUBLISHABLE_KEY=pk_test_dummy
# Clerk user ids (coma-separados) que serán super admin de plataforma.
SUPERADMIN_USER_IDS=

# ---- Integraciones externas (placeholders: el server arranca; las llamadas
#      reales a Evolution/Chatwoot fallarán hasta poner valores válidos) ----
EVOLUTION_API_URL=https://evolutionapi.diegop.com
EVOLUTION_API_KEY=dev-dummy
EVOLUTION_WEBHOOK_TOKEN=dev-dummy
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000

CHATWOOT_API_URL=https://chatwoot.diegop.com
CHATWOOT_API_TOKEN=dev-dummy
CHATWOOT_PLATFORM_TOKEN=dev-dummy
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_ADMIN_USER_ID=1

WEBHOOK_SECRET=dev-secret

# ---- IA (opcional) ----
# Sin estas claves el bot no genera respuestas ni indexa conocimiento, pero la
# data de prueba (que ya trae chunks/embeddings sintéticos) se carga igual.
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=12000

# ---- Seed ----
# Si lo pones, el escenario "Acme" se carga bajo ESTE tenant (úsalo con tu org
# real de Clerk para manejar la data desde la UI). Vacío => usa "org_seed_acme".
SEED_PRIMARY_TENANT=
