# ===========================================================================
# bot-plataform / infra Dokploy — variables del compose.
# Pegar en Dokploy -> Compose -> Environment. El .env real NO se versiona.
# ===========================================================================

# ---- Backend ----
CORS_ORIGIN=https://sira.opensolvex.co
# Base pública del backend: con ella se registran los webhooks al provisionar.
PUBLIC_WEBHOOK_BASE_URL=https://api.sira.opensolvex.co

# Postgres compartido "labs" (proyecto databases). Requiere DB+user "botplatform".
DATABASE_URL=postgresql://botplatform:CHANGE_ME@databases-labs-bkbvsy:5432/botplatform
# Redis compartido, db index 5 (reservado a bot-plataform).
REDIS_URL=redis://default:CHANGE_ME@databases-redis-vlzs7g:6379/5

# Clerk (Organizations habilitado)
CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
# Super admins de plataforma (Clerk user ids, coma-separados). Bootstrap inicial.
SUPERADMIN_USER_IDS=

# Evolution API (Dokploy)
EVOLUTION_API_URL=https://evolutionapi.diegop.com
EVOLUTION_API_KEY=CHANGE_ME
# Token que Evolution manda en el header x-webhook-token de cada webhook.
EVOLUTION_WEBHOOK_TOKEN=CHANGE_ME

# Chatwoot (Dokploy)
CHATWOOT_API_URL=https://chatwoot.diegop.com
CHATWOOT_API_TOKEN=CHANGE_ME
# Platform API (provisión de cuentas/usuarios por tenant).
CHATWOOT_PLATFORM_TOKEN=CHANGE_ME
CHATWOOT_ACCOUNT_ID=1
# User id del dueño de CHATWOOT_API_TOKEN (se adjunta admin a cada cuenta).
CHATWOOT_ADMIN_USER_ID=1

# Webhooks entrantes
WEBHOOK_SECRET=CHANGE_ME

# ---- IA (E05/E06/E07) ----
ANTHROPIC_API_KEY=CHANGE_ME
# Haiku (económico) por defecto; para demos a inversores: claude-opus-4-8.
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=12000
# Embeddings de la base de conocimiento (sin esta key, las fuentes quedan failed).
OPENAI_API_KEY=CHANGE_ME
EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Frontend (build args, horneados en build-time) ----
VITE_API_URL=https://api.sira.opensolvex.co
VITE_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
